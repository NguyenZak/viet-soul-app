{
  "buildCommand": "cd vietsoul-web && npm run vercel-build",
  "outputDirectory": "vietsoul-web/.next",
  "framework": "nextjs",
  "installCommand": "cd vietsoul-web && npm install --legacy-peer-deps",
  "devCommand": "cd vietsoul-web && npm run dev",
  "regions": ["sin1"],
  "functions": {
    "vietsoul-web/app/api/**/*.ts": {
      "runtime": "nodejs18.x"
    }
  },
  "env": {
    "NODE_ENV": "production",
    "CI": "false",
    "SKIP_ENV_VALIDATION": "true"
  }
}
